#!/usr/bin/env bash
# Installs HAProxy and balances traffic between web-01 and web-02 (roundrobin)
apt-get -y update
apt-get -y install haproxy
if ! grep -q "backend web_servers" /etc/haproxy/haproxy.cfg
then
  cat >> /etc/haproxy/haproxy.cfg <<HAP

frontend http_front
    bind *:80
    mode http
    default_backend web_servers

backend web_servers
    mode http
    balance roundrobin
    server 7319-web-01 16.60.136.184:80 check
    server 7319-web-02 18.133.182.40:80 check
HAP
fi
sed -i 's/ENABLED=0/ENABLED=1/' /etc/default/haproxy 2>/dev/null
service haproxy restart
